class Solution {
    public boolean lemonadeChange(int[] bills) {
       int n=bills.length;
       int c=0;
       int b=0;
       int d=0;
       for(int i=0;i<n;i++)
       {
           if(bills[i]==5)
            {
            c++;
             }
            else if(bills[i]==10)
            {
               if(c>=1)
               {
                c--;
                b++;
                }
            else
            {
                return false;
            }
        
        }
        else
         {
            if(b>=1 && c>=1)
            {
                b--;
                c--;
                d++;
            }
            else if(c>=3)
            {
                c-=3;
                d++;
            }
            else
            {
                return false;
            }
          }
       }
       return true;

    }
}
